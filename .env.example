# Copy to .env and fill in.

PORT=8787

# A random path segment used as a lightweight shared secret in both webhook URLs
# (e.g. https://<tunnel>/from-chatwoot/<this token>). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRIDGE_TOKEN=

CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_INBOX_IDENTIFIER=

# For pushing delivered/read status back onto an agent's message (PATCH .../messages/{id}).
# Needs an agent's personal Access Token (Profile Settings) - unavailable on a Chatwoot Cloud
# trial plan ("API access tokens are available on paid plans"), but should be free to get on a
# self-hosted instance. Leave CHATWOOT_API_ACCESS_TOKEN blank to disable this feature - the
# bridge logs and skips status updates instead of failing.
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=

BUBBL_API_BASE_URL=https://api.business.bubbl.dev
BUBBL_BUSINESS_PROFILE_UUID=
# bubbl-business Public API credential (client secret) - Business dashboard -> that business
# profile -> Credentials -> Generate.
BUBBL_API_KEY=

# Signs every bubbl -> Chatwoot webhook delivery (X-Hub-Signature-256). Shown once at
# subscription creation on the dashboard's Webhooks screen - recreate the subscription to see
# it again if lost, there's no way to retrieve it after the fact. Leave blank to run without
# signature verification (falls back to URL-obscurity only, with a loud startup warning).
BUBBL_WEBHOOK_SECRET=
